APP_NAME=BuscaAI
DEBUG=false

# Local (host) default. When running via docker-compose, DATABASE_URL is
# overridden to point at the "db" service (see docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://buscaai:buscaai@localhost:5432/buscaai

# Where uploaded PDFs are stored (local filesystem, one prefix per user).
STORAGE_DIR=./storage

# OAuth 2.0 Client ID from Google Cloud Console (used to validate the
# audience of Google ID tokens sent by the client).
GOOGLE_CLIENT_ID=

JWT_SECRET=57ff3d57565261e6f1376cf72034418db4425fbaeb6fa361936bac1e504638a9
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_MINUTES=240
JWT_REFRESH_EXPIRES_DAYS=7
